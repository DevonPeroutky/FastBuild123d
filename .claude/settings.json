{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/inject-python-standards.sh\"",
            "timeout": 10,
            "statusMessage": "Loading Python standards"
          }
        ]
      }
    ]
  }
}
